{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "noEmit": true,
        "noUncheckedIndexedAccess": true,
        "forceConsistentCasingInFileNames": true,
        "verbatimModuleSyntax": true,
        "types": ["bun-types", "node"]
    },
    "include": ["tests/**/*"],
    "exclude": ["node_modules", "tmp"]
}
