{% for (const user of $.users) { %}
INSERT INTO "user" (username, email)
VALUES (
    {%~ $.quote(user.username) %},
    {%~ $.quote(user.email) %}
)
ON CONFLICT (email) DO UPDATE SET
    username = EXCLUDED.username;

{% } %}

