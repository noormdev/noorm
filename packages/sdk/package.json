{
  "name": "@noormdev/sdk",
  "version": "1.10.1",
  "description": "Database schema & changeset manager SDK",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "NOTICE"
  ],
  "sideEffects": false,
  "peerDependencies": {
    "kysely": "^0.28.0",
    "better-sqlite3": "^12.0.0",
    "pg": "^8.0.0",
    "mysql2": "^3.0.0",
    "tedious": "^19.2.0"
  },
  "peerDependenciesMeta": {
    "better-sqlite3": {
      "optional": true
    },
    "pg": {
      "optional": true
    },
    "mysql2": {
      "optional": true
    },
    "tedious": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.13"
  },
  "keywords": [
    "database",
    "schema",
    "migrations",
    "sdk",
    "kysely",
    "noorm"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noormdev/noorm.git"
  }
}
